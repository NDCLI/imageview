{
  "name": "local-image-compare",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --check src public package.json vite.config.js eslint.config.js .prettierrc .github/workflows/ci.yml",
    "prepare": "husky"
